# ---------------------------------------------------------------------------
# Oddless — environment configuration
#
# Canonical network is GenLayer Studionet ONLY (chain 61999). Do not point
# NEXT_PUBLIC_GENLAYER_RPC_URL or NEXT_PUBLIC_GENLAYER_CHAIN_ID at Studio-dev
# (61997), localnet, or any other GenLayer network for production builds.
# `scripts/check-network-config.ts` fails the build if these drift.
# ---------------------------------------------------------------------------

# Public network config (safe to expose to the browser)
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_EXPLORER_URL=https://explorer-studio.genlayer.com
NEXT_PUBLIC_GENLAYER_CHAIN_NAME="GenLayer Studionet"
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN

# Deployed contract addresses (filled in after `scripts/deploy.ts` runs)
NEXT_PUBLIC_DUEL_CONTRACT_ADDRESS=
NEXT_PUBLIC_VAULT_CONTRACT_ADDRESS=

# ---------------------------------------------------------------------------
# Deployment-only secrets (NEVER committed, NEVER shipped to the browser,
# NEVER read by any `NEXT_PUBLIC_*` code path). Used only by
# `scripts/deploy.ts` run locally / in an opt-in CI job with a funded
# Studionet signer. The product itself never manages a signer — the user
# always signs with their own injected wallet.
# ---------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=

# Python test / gltest config (see contracts/ tests)
RPCPROTOCOL=https
RPCHOST=studio.genlayer.com
RPCPORT=443
